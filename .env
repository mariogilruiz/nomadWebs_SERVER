# Archivo de configuración de variables de entorno para el servidor websnomadas.
# Primero la nombramos aqui y despues la añadios al middleware corsMiddleware.

PORT=3002
MONGO_URI=##
CORS_ORIGINS=http://localhost:3000,https://www.websnomadas.com,https://www.websnomadas.com
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
MONGO_URI=mongodb+srv://nuriaUser:YoBtjRE1TCuTdcvD@nuriacluster.4ksl4.mongodb.net/?retryWrites=true&w=majority&appName=nuriaCluster


 # SMTP base para IONOS
SMTP_HOST=smtp.ionos.es
SMTP_PORT=587
SMTP_SECURE=false


# Credenciales SMTP por sitio: el sufijo coincide con el siteSlug de
# src/data/<sitio>/contact-email.json, convertido a mayusculas.
# Ejemplo: siteSlug "nuriajimenezmakeup" usa SMTP_USER_NURIAJIMENEZMAKEUP
# y SMTP_PASS_NURIAJIMENEZMAKEUP. SMTP_HOST, SMTP_PORT y SMTP_SECURE
# son comunes para todos los sitios.
SMTP_USER_WEBSNOMADAS=info@websnomadas.com
SMTP_PASS_WEBSNOMADAS=wjKn8cU3Sa6WGTx



SMTP_USER_NURIAJIMENEZMAKEUP=correo@dominio-de-nuria.com
SMTP_PASS_NURIAJIMENEZMAKEUP=contraseña-de-aplicación